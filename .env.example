# voice-prompt-cleaner — Environment Configuration
# Copy this file to .env and fill in values for your environment.
# See tasks/env-unification-plan.md for the full naming convention reference.
# NEVER commit .env — only .env.example is tracked.
#
# This is a purely client-side app — no server, no database, no auth.
# Users provide their own API key via the in-app Settings panel (stored in
# localStorage on their machine, never sent to any server we control).

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5173                              # Vite default port

# ── AI — Default LLM Endpoint (optional) ──────────────────────────────────────
# Sets the pre-filled value in the Settings panel. Users can override in the UI.
# DO NOT put a real API key here — VITE_* variables are bundled into the JS.
# The actual key lives only in the user's browser (localStorage).
VITE_DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
VITE_DEFAULT_LLM_MODEL=gpt-4o-mini
