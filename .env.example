# Optional: default LLM endpoint (OpenAI-compatible Chat Completions API).
# Users can override these in the in-app Settings panel; values entered there
# are stored in localStorage on the user's machine and are NEVER bundled.
# Do not commit real keys to .env — keep them only in .env.local (gitignored).
VITE_DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
VITE_DEFAULT_LLM_MODEL=gpt-4o-mini

# DO NOT put a real API key here. The frontend reads the user's key from the
# in-app Settings panel (localStorage). Embedding a key in VITE_* would expose
# it to every visitor of the deployed bundle.
